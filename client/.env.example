# Flask/OpenCV backend (server/) base URL. Defaults to the live Render deploy
# (https://jules-mpano-s-personal-website.onrender.com) if unset. Override to
# http://localhost:5001 to test against a local `python server/app.py` instead.
NEXT_PUBLIC_API_URL=

# Substack publication URL. Leave unset until the client provides one --
# the /essays page and its subscribe CTA gracefully hide/skip Substack when empty.
SUBSTACK_URL=

# Google Search Console verification token (the content value from the
# "HTML tag" verification method). Leave unset until you set up Search Console;
# no verification meta tag is emitted when empty.
GOOGLE_SITE_VERIFICATION=
