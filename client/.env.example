# Flask/OpenCV backend (server/) base URL. Defaults to http://localhost:5001 in code
# if unset, so this file is optional for local dev.
NEXT_PUBLIC_API_URL=http://localhost:5001

# Substack publication URL. Leave unset until the client provides one --
# the /essays page and its subscribe CTA gracefully hide/skip Substack when empty.
SUBSTACK_URL=
